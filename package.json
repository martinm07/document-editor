{
	"name": "svelte-html-document-editor",
	"description": "A lightweight, visual document editor that embraces HTML, CSS and Svelte directly",
	"version": "0.0.1",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"@types/css-tree": "^2.3.10",
		"@types/he": "^1.2.3",
		"@types/node": "^22.15.29"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@bramus/specificity": "^2.4.2",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@csstools/cascade-layer-name-parser": "^2.0.5",
		"@replit/codemirror-lang-svelte": "^6.0.0",
		"@rollup/browser": "^4.64.0",
		"color": "^5.0.3",
		"css-selector-parser": "^3.1.2",
		"css-shorthand-properties": "^1.1.2",
		"css-tree": "^3.1.0",
		"fuse.js": "^7.1.0",
		"he": "^1.2.0",
		"htmlparser2": "^12.0.0",
		"paneforge": "^1.0.2",
		"runed": "^0.28.0",
		"svelte": "^5.57.2",
		"thememirror": "^2.0.1",
		"phosphor-svelte": "^3.1.1"
	}
}
